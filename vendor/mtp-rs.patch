+/// data header can say 4 GB, or it can go on sending without ever sending a
+/// response, and the whole reply is held in memory until it is parsed. A
+/// download is streamed instead and has no such limit.
+pub(crate) const MAX_BUFFERED_BYTES: usize = 256 * 1024 * 1024;
+
+/// An error when a reply of `bytes` (so far, or as its header says) is more
+/// than `limit` allows.
+pub(crate) fn within_limit(bytes: usize, limit: usize) -> Result<(), crate::PtpError> {
+    if bytes > limit {
+        return Err(crate::PtpError::invalid_data(format!(
+            "reply too large to hold in memory: {bytes} bytes, at most {limit}"
+        )));
+    }
+    Ok(())
