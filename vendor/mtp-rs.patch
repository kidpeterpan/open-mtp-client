+/// Change the battery level an open virtual device reports (as a phone's does
+/// while it charges), and announce it with a `DevicePropChanged` event for
+/// BatteryLevel, as Android does. Returns `false` if no open device has that
+/// serial. A device opened without a level keeps reporting none: what it
+/// supports was fixed at open.
+pub fn set_virtual_battery_level(serial: &str, level: u8) -> bool {
+    let active = active_states().lock().unwrap();
+    let state_arc = match active.iter().find(|(s, _)| s == serial) {
+        Some((_, state)) => Arc::clone(state),
+        None => return false,
+    };
+    drop(active); // Release the registry lock before acquiring the state lock.
+    let mut state = state_arc.lock().unwrap();
+    if state.config.battery_level.is_some() {
+        state.config.battery_level = Some(level);
+        let battery = u32::from(u16::from(crate::ptp::DevicePropertyCode::BatteryLevel));
+        state.event_queue.push_back(super::builders::build_event(
+            crate::ptp::EventCode::DevicePropChanged,
+            &[battery],
+        ));
